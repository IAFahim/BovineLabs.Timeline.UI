/* Damage vignette skin. Full-screen (per viewport) red edge glow; the system only drives `opacity` (0 = hidden).
   Swap the background-image for a proper radial vignette texture, or tune the inset border glow here — no code change.
   The system positions per-player overlays (left/top/width/height) from the resolved viewport; the shared overlay stays
   full-screen via the absolute-fill defaults below. */
.vex-vignette {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    /* Inset red glow using a thick, blurred-looking border tint. Replace with background-image for a texture vignette. */
    border-left-width: 90px;
    border-right-width: 90px;
    border-top-width: 60px;
    border-bottom-width: 60px;
    border-left-color: rgba(200, 20, 20, 0.55);
    border-right-color: rgba(200, 20, 20, 0.55);
    border-top-color: rgba(200, 20, 20, 0.45);
    border-bottom-color: rgba(200, 20, 20, 0.45);
    border-top-left-radius: 120px;
    border-top-right-radius: 120px;
    border-bottom-left-radius: 120px;
    border-bottom-right-radius: 120px;
}
