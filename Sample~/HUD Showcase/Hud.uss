/* ============================================================================
   Co-op HUD skin — EVERYTHING visual lives here. Edit colors/sizes/textures/
   layout freely; no code change or recompile needed. Structure = Hud.uxml,
   behavior floats (fill/ghost/flash) = the HudBar primitive + the driver.
   ============================================================================ */

.vex-hud {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ---- corners ---- */
.vex-hud__corner { position: absolute; }
.vex-hud__corner--tl { top: 16px; left: 16px; }
.vex-hud__corner--tr { top: 16px; right: 16px; }
.vex-hud__corner--bl { bottom: 16px; left: 16px; }
.vex-hud__corner--br { bottom: 16px; right: 16px; }

/* ---- card ---- */
/* Visibility is USS: the driver only toggles .is-hidden (it signals state); this owns the look.
   "Always visible" needs nothing here — a card is shown by default. Auto-hidden / absent rows get .is-hidden. */
.vex-hud__card {
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.15s; /* snappy fade-IN (world parity) */
    min-width: 210px;
    padding: 8px 12px 10px 12px;
    background-color: rgba(14, 16, 22, 0.82);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 3px;
    border-left-color: rgb(120, 130, 145);
}
.vex-hud__card.is-hidden { transition-duration: 0.4s; opacity: 0; } /* lazy fade-OUT */

.vex-hud__card--p0 { border-left-color: rgb(74, 163, 255); }
.vex-hud__card--p1 { border-left-color: rgb(70, 209, 122); }
.vex-hud__card--p2 { border-left-color: rgb(255, 181, 84); }
.vex-hud__card--p3 { border-left-color: rgb(255, 107, 158); }

/* ---- header (name + value) ---- */
.vex-hud__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}
.vex-hud__name { font-size: 15px; -unity-font-style: bold; color: rgb(235, 238, 244); }
.vex-hud__card--p0 .vex-hud__name { color: rgb(74, 163, 255); }
.vex-hud__card--p1 .vex-hud__name { color: rgb(70, 209, 122); }
.vex-hud__card--p2 .vex-hud__name { color: rgb(255, 181, 84); }
.vex-hud__card--p3 .vex-hud__name { color: rgb(255, 107, 158); }
.vex-hud__value { font-size: 13px; color: rgba(255, 255, 255, 0.78); }

/* ============================================================================
   HudBar primitive skin (.vex-bar + __track __ghost-inner __fill-inner __frame __flash)
   ============================================================================ */
.vex-hud__bar { margin-top: 6px; }

.vex-bar { flex-grow: 0; --vex-low-tint: rgb(255, 90, 70); --vex-flash-max: 0.45; }

/* track doubles as the empty/back: the blade silhouette darkened, so the unfilled part reads as a spent blade */
.vex-bar__track {
    height: 20px;
    background-image: url("/Assets/HudShowcase/Textures/Arvex_HP_fill_cropped.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgba(10, 6, 6, 0.9);
}

/* fill = the blade body texture; clipped by the bound `value` (reveals, never squashes) */
.vex-bar__fill-inner {
    background-image: url("/Assets/HudShowcase/Textures/Arvex_HP_fill_cropped.png");
    background-size: 100% 100%;
}

/* frame = the outline art, drawn over the whole bar */
.vex-bar__frame {
    background-image: url("/Assets/HudShowcase/Textures/Arvex_HP_cropped.png");
    background-size: 100% 100%;
}

/* locked band (curse) = cropped blade tip at the high end the fill can't reach. STRUCTURE — never a damage cue. */
.vex-bar__locked-inner {
    background-image: url("/Assets/HudShowcase/Textures/Arvex_HP_fill_cropped.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgba(45, 35, 70, 0.92);
}

/* ghost slider = a CROPPED slice of the blade (full-size, windowed by the driver — never squashed). Uses the WHITE
   silhouette so the tint actually shows (a multiply tint can't recolor the red fill blade). Amber = recently lost. */
.vex-bar__ghost-inner {
    background-image: url("/Assets/HudShowcase/Textures/Arvex_HP_flash.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgb(255, 205, 70);
}

/* heal: the gained slice (ghost below the fill) tints green */
.vex-bar--healing .vex-bar__ghost-inner {
    -unity-background-image-tint-color: rgb(95, 230, 130);
}

/* chip trail = cropped blade slice the driver accumulates then drops/drains (eased "swish"). Hot lost-health color. */
.vex-bar__chip-inner {
    background-image: url("/Assets/HudShowcase/Textures/Arvex_HP_flash.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgb(255, 170, 60);
}

/* low-health recolor is CONTINUOUS (HudBar lerps fill-inner tint white→--vex-low-tint). Set the hue here. */
